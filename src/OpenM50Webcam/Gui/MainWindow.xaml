<Window x:Class="OpenM50Webcam.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenM50 Webcam" Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon-256.png"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0F1319"/>
        <SolidColorBrush x:Key="Card" Color="#161B23"/>
        <SolidColorBrush x:Key="Line" Color="#232A35"/>
        <SolidColorBrush x:Key="Text" Color="#E8ECF1"/>
        <SolidColorBrush x:Key="Sub" Color="#8A94A6"/>
        <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2630"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C4373C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#1F2630"/>
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3340"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#323D4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2433"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="2,5,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Fill" Value="#5A6270"/>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="14" Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Title bar -->
            <Grid Height="46" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/icon-256.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="OpenM50 Webcam" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Quit_Click" ToolTip="Quit">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Live preview -->
            <Grid Margin="16,0,16,0" Height="198">
                <Border x:Name="PreviewFrame" CornerRadius="10" Background="#0A0D12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                <Border x:Name="PreviewImage" CornerRadius="10" Margin="1"/>
                <StackPanel x:Name="PreviewOverlay" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M4,8 h22 a3,3 0 0 1 3,3 v13 a3,3 0 0 1 -3,3 h-22 a3,3 0 0 1 -3,-3 v-13 a3,3 0 0 1 3,-3 z M11,8 l2,-3 h6 l2,3 M15,21 m-5,0 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0"
                          Stroke="#4A5568" StrokeThickness="1.5" HorizontalAlignment="Center" Width="32" Height="30"
                          Stretch="Uniform"/>
                    <TextBlock x:Name="PreviewText" Text="Waiting for camera …" Foreground="{StaticResource Sub}"
                               Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="FpsBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                        Background="#99000000" CornerRadius="6" Padding="7,2" Visibility="Collapsed">
                    <TextBlock x:Name="FpsText" Foreground="White" FontSize="11"/>
                </Border>
            </Grid>

            <!-- Status -->
            <Border Margin="16,14,16,0" CornerRadius="10" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="CameraDot" Style="{StaticResource Dot}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="CameraTitle" Style="{StaticResource RowTitle}" Text="Looking for camera …"/>
                            <TextBlock x:Name="CameraDetail" Style="{StaticResource RowDetail}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line}" Margin="14,0"/>
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="WebcamDot" Style="{StaticResource Dot}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="WebcamTitle" Style="{StaticResource RowTitle}" Text="Webcam"/>
                            <TextBlock x:Name="WebcamDetail" Style="{StaticResource RowDetail}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line}" Margin="14,0"/>
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StreamDot" Style="{StaticResource Dot}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StreamTitle" Style="{StaticResource RowTitle}" Text="OBS stream"/>
                            <TextBlock x:Name="StreamDetail" Style="{StaticResource RowDetail}"/>
                        </StackPanel>
                        <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Copy URL"
                                VerticalAlignment="Center" Click="CopyUrl_Click" ToolTip="Copy the URL for an OBS Browser source"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Warning -->
            <Border x:Name="WarningBanner" Visibility="Collapsed" Margin="16,12,16,0" CornerRadius="10"
                    Background="#221C14" BorderBrush="#4A3A22" BorderThickness="1" Padding="14,10">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#F2C27E" FontSize="12"/>
            </Border>

            <!-- Footer -->
            <Grid Margin="16,14,16,16">
                <TextBlock x:Name="FooterText" Foreground="#5F6878" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="QuitButton" Content="Quit" HorizontalAlignment="Right"
                        Style="{StaticResource PillButton}" Click="Quit_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
